{
  // Type checking for the editor only. Node runs the .ts files directly with
  // --experimental-strip-types, so there is no build step: imports carry the .ts
  // extension, and only syntax that can be erased is allowed (no enum, no namespace,
  // no constructor parameter properties).
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src", "test", "scripts"]
}
